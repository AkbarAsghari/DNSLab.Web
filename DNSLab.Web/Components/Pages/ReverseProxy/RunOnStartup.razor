@using DNSLab.Web.Enums
@attribute [Route(AllRoutes.RunTunnelOnStartUp)]
@attribute [Authorize]
<SeoProvider Title="اجرای خودکار تونل در Startup" />

<MudText Typo="Typo.h1" Align="Align.Center">اجرای خودکار تونل هنگام راه‌اندازی ویندوز</MudText>
<MudText Class="mt-5 mb-10" Align="Align.Center">
    با استفاده از Task Scheduler ویندوز، می‌توانید DNSLab را به‌صورت خودکار هنگام راه‌اندازی سیستم اجرا کنید.
</MudText>

<MudCard Elevation="0">
    <MudCardContent>
        <MudPaper Class="mt-5 pa-10" Elevation="0">
            <MudText Typo="Typo.h4" Class="mb-4">
                1. آماده‌سازی DNSLab CLI
            </MudText>
            <MudText Class="my-2">
                ابتدا نسخه مناسب DNSLab CLI را متناسب با معماری سیستم خود دانلود کنید:
            </MudText>
            <MudStack Row Class="mb-3">
                <BaseButton Size="Size.Small"
                            EndIcon="@DNSLabIcons.Download"
                            Color="Color.Primary"
                            Variant="Variant.Filled"
                            DropShadow="false"
                            Href="https://cdn.dnslab.link/dnslab-windows-amd64.exe">
                    دانلود نسخه Windows x64
                </BaseButton>
                <BaseButton Size="Size.Small"
                            EndIcon="@DNSLabIcons.Download"
                            Color="Color.Primary"
                            Variant="Variant.Filled"
                            DropShadow="false"
                            Href="https://cdn.dnslab.link/dnslab-windows-arm64.exe">
                    دانلود نسخه Windows ARM64
                </BaseButton>
            </MudStack>
            <MudText Class="my-2">
                سپس فایل دانلودشده را به
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">dnslab.exe</MudChip>
                تغییر نام داده و در یک مسیر ثابت مانند مسیر زیر قرار دهید:
            </MudText>
            <CodeSnippet Language="text" Code="C:\DNSLab\dnslab.exe" />
            <MudText Class="mt-3">
                در صورت استفاده از فایل Config، فایل
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">config.yaml</MudChip>
                را نیز در یک مسیر ثابت مانند مسیر زیر قرار دهید:
            </MudText>
            <CodeSnippet Language="text" Code="C:\DNSLab\config.yaml" />
            <MudText Typo="Typo.h4" Class="mt-6 mb-4">
                2. ثبت توکن DNSLab CLI
            </MudText>
            <MudText Class="my-2">
                قبل از ایجاد Task، یک بار فایل
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">dnslab.exe</MudChip>
                را اجرا کنید.
            </MudText>
            <MudText Class="my-2">
                سپس دستور ثبت توکن را وارد کنید تا DNSLab CLI به حساب کاربری شما متصل شود.
            </MudText>
            <CodeSnippet Language="bash"
                         Code="@($"token set {_Token}")" />

            <MudAlert Severity="Severity.Success"
                      ContentAlignment="HorizontalAlignment.Start"
                      Class="mt-4">
                این عملیات فقط یک بار انجام می‌شود و توکن در تنظیمات CLI ذخیره خواهد شد.
            </MudAlert>

            <MudText Class="mt-3">
                پس از ثبت موفق توکن، می‌توانید مراحل بعدی را برای اجرای خودکار DNSLab در Startup ویندوز انجام دهید.
            </MudText>
            <MudText Typo="Typo.h4" Class="mt-6 mb-4">
                3. باز کردن Task Scheduler
            </MudText>
            <MudText Class="my-2">
                کلیدهای Win + R را فشار دهید، عبارت زیر را وارد کرده و Enter بزنید:
            </MudText>
            <CodeSnippet Language="text" Code="taskschd.msc" />

            <MudText Typo="Typo.h4" Class="mt-6 mb-4">
                4. ساخت Task جدید
            </MudText>
            <MudText Class="my-2">
                در Task Scheduler از منوی
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Action</MudChip>
                گزینه
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Create Task</MudChip>
                را انتخاب کنید.
            </MudText>
            <MudText Class="my-2">
                در قسمت Name یک نام مانند
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">DNSLab</MudChip>
                وارد کنید.
            </MudText>

            <MudText Typo="Typo.h4" Class="mt-6 mb-4">
                5. تنظیم اجرای خودکار
            </MudText>
            <MudText Class="my-2">
                وارد تب
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Triggers</MudChip>
                شوید و یک Trigger از نوع
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">At startup</MudChip>
                ایجاد کنید.
            </MudText>
            <MudText Class="my-2">
                برای اطمینان از آماده شدن سرویس‌های ویندوز و شبکه، می‌توانید گزینه تأخیر اجرا را روی حدود 30 ثانیه قرار دهید.
            </MudText>

            <MudText Typo="Typo.h4" Class="mt-6 mb-4">
                6. تنظیم اجرای DNSLab
            </MudText>
            <MudText Class="my-2">
                وارد تب
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Actions</MudChip>
                شوید و یک Action از نوع
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Start a program</MudChip>
                ایجاد کنید.
            </MudText>

            <MudPaper Outlined Class="pa-5 mt-3">
                <MudText Typo="Typo.h6" Class="mb-3">
                    Program/script
                </MudText>
                <MudText Class="mb-2">
                    مسیر فایل DNSLab CLI را وارد کنید.
                </MudText>
                <CodeSnippet Language="text" Code="C:\DNSLab\dnslab.exe" />

                <MudText Typo="Typo.h6" Class="mt-5 mb-3">
                    Arguments
                </MudText>
                <MudText Class="mb-4">
                    دستور را مطابق مستندات DNSLab و بر اساس نوع تونل موردنظر وارد کنید.
                </MudText>

                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-4" Outlined>
                            <MudText Typo="Typo.h6">HTTP</MudText>
                            <MudText Typo="Typo.body2">
                                مناسب برای وب‌سایت، API و Webhook
                            </MudText>
                            <BaseButton Href="@AllRoutes.HttpReverseProxy"
                                        Class="mt-3"
                                        Size="Size.Small"
                                        Variant="Variant.Filled"
                                        Color="Color.Primary">
                                مشاهده آموزش
                            </BaseButton>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-4" Outlined>
                            <MudText Typo="Typo.h6">TCP</MudText>
                            <MudText Typo="Typo.body2">
                                مناسب برای SSH، RDP، FTP و دیتابیس‌ها
                            </MudText>
                            <BaseButton Href="@AllRoutes.TcpReverseProxy"
                                        Class="mt-3"
                                        Size="Size.Small"
                                        Variant="Variant.Filled"
                                        Color="Color.Primary">
                                مشاهده آموزش
                            </BaseButton>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-4" Outlined>
                            <MudText Typo="Typo.h6">UDP</MudText>
                            <MudText Typo="Typo.body2">
                                مناسب برای DNS، بازی آنلاین و VoIP
                            </MudText>
                            <BaseButton Href="@AllRoutes.UdpReverseProxy"
                                        Class="mt-3"
                                        Size="Size.Small"
                                        Variant="Variant.Filled"
                                        Color="Color.Primary">
                                مشاهده آموزش
                            </BaseButton>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-5" />

                <MudText Typo="Typo.h6" Class="mb-3">
                    استفاده از Config
                </MudText>
                <MudText Class="mb-2">
                    در صورت استفاده از فایل Config، دستور را مطابق مستندات DNSLab وارد کرده و مسیر فایل را مشخص کنید.
                </MudText>
                <CodeSnippet Language="text" Code="start --config C:\DNSLab\config.yaml" />
                <BaseButton Href="@AllRoutes.UdpReverseProxy"
                            Class="mt-3"
                            Size="Size.Small"
                            Variant="Variant.Filled"
                            Color="Color.Primary">
                    مشاهده آموزش ایجاد فایل Config
                </BaseButton>
            </MudPaper>

            <MudText Typo="Typo.h4" Class="mt-6 mb-4">
                7. تنظیم نحوه اجرای Task
            </MudText>
            <MudText Class="my-2">
                در تب
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">General</MudChip>
                می‌توانید گزینه
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Run whether user is logged on or not</MudChip>
                را انتخاب کنید تا DNSLab حتی بدون ورود کاربر به ویندوز نیز اجرا شود.
            </MudText>
            <MudText Class="my-2">
                در تب
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Settings</MudChip>
                گزینه
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Allow task to be run on demand</MudChip>
                را فعال نگه دارید.
            </MudText>

            <MudText Typo="Typo.h4" Class="mt-6 mb-4">
                8. ذخیره و تست Task
            </MudText>
            <MudText Class="my-2">
                پس از تکمیل تنظیمات، روی OK کلیک کنید تا Task ذخیره شود.
            </MudText>
            <MudText Class="my-2">
                سپس در Task Scheduler روی Task ساخته‌شده کلیک راست کرده و گزینه
                <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">Run</MudChip>
                را انتخاب کنید.
            </MudText>
            <MudText Class="my-2">
                اگر DNSLab بدون خطا اجرا شد و تونل برقرار شد، تنظیمات با موفقیت انجام شده است.
            </MudText>

            <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Start" Dense Class="mt-5">
                <MudText>
                    برای اجرای خودکار DNSLab هنگام روشن شدن ویندوز، استفاده از Trigger نوع
                    <MudChip T="string" Label="true" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">At startup</MudChip>
                    پیشنهاد می‌شود. در صورت نیاز می‌توانید اجرای Task را با تأخیر حدود 30 ثانیه تنظیم کنید.
                </MudText>
            </MudAlert>

            <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Start" Dense Class="mt-2">
                <MudText>
                    اگر از لپ‌تاپ استفاده می‌کنید، تنظیمات مربوط به اجرای Task هنگام استفاده از باتری را بررسی کنید؛ این تنظیمات ممکن است از اجرای خودکار DNSLab جلوگیری کنند.
                </MudText>
            </MudAlert>
        </MudPaper>
    </MudCardContent>
</MudCard>