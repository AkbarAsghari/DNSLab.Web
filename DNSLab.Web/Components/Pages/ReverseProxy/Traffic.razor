@attribute [Route(AllRoutes.ReverseProxyTraffic)]
@attribute [Authorize]

<SeoProvider Title="ترافیک مصرفی" />

<MudText Typo="Typo.h1" Align="Align.Center">ترافیک مصرفی</MudText>
<MudText Class="mt-5 mb-10" Align="Align.Center">
    میزان مصرف و ترافیک باقی‌مانده حساب شما
    <MudFlexBreak />
    اولویت مصرف: هدیه ← ماهانه ← پلن ← ترافیک اضافه
</MudText>
<MudCard Elevation="0">
    <MudCardHeader>
        <CardHeaderContent />
        <CardHeaderActions>
            <MudButton EndIcon="@DNSLabIcons.Add" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" OnClick="RechargeTraffic">ترافیک اضافه</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>

        @if (_Traffics != null)
        {
            <MudGrid Spacing="2">
                @foreach (var item in _Traffics)
                {
                    var used = item.Traffic - item.RemainTraffic;
                    var percent = item.Traffic > 0
                    ? (double)used / item.Traffic * 100
                    : 0;

                    var color = percent >= 90
                    ? Color.Error
                    : percent >= 70
                    ? Color.Warning
                    : Color.Success;

                    <MudItem xs="12" md="6">
                        <MudCard Outlined>
                            <MudCardContent>

                                <MudStack Row
                                          AlignItems="AlignItems.Center"
                                          Justify="Justify.SpaceBetween">

                                    <MudText Typo="Typo.h6">
                                        @item.Type
                                    </MudText>

                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@color"
                                             Label=true>
                                        @percent.ToString("0")٪
                                    </MudChip>

                                </MudStack>

                                <MudStack Row
                                          AlignItems="AlignItems.End"
                                          Spacing="1"
                                          Class="mt-4">

                                    <MudText Typo="Typo.h4">
                                        @item.RemainTraffic.ToReadableSize()
                                    </MudText>

                                    <MudText Typo="Typo.body2">
                                        باقی‌مانده از @item.Traffic.ToReadableSize()
                                    </MudText>

                                </MudStack>

                                <MudProgressLinear Max="@item.Traffic"
                                                   Value="@used"
                                                   Rounded
                                                   Color="@color"
                                                   Class="my-3" />

                                <MudStack Row
                                          Justify="Justify.SpaceBetween">

                                    <MudText Typo="Typo.caption">
                                        مصرف شده: @used.ToReadableSize()
                                    </MudText>

                                    <MudText Typo="Typo.caption">
                                        @(item.FromDate.HasValue? item.FromDate.Value.ToPersianDate() : "♾️")
                                        -
                                        @(item.ToDate.HasValue? item.ToDate.Value.ToPersianDate() : "♾️")
                                    </MudText>

                                </MudStack>

                                @if (item.RemainTraffic <= 0)
                                {
                                    <MudAlert Dense
                                              Severity="Severity.Error"
                                              Variant="Variant.Text"
                                              Class="mt-3">
                                        ترافیک این بخش به پایان رسیده است.
                                    </MudAlert>
                                }

                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudCardContent>
</MudCard>