@using DNSLab.Web.API.Page.Enums
@using DNSLab.Web.DTOs.Repositories.Page
@attribute [Route(AllRoutes.Page + "/{PageId:guid}")]
@attribute [Route(AllRoutes.Page)]
@attribute [Authorize]
<SeoProvider Title="ویرایش صفحه" />

<MudText Typo="Typo.h1" Class="mb-10" Align="Align.Center">ویرایش صفحه</MudText>

<MudCard Elevation="0">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5"></MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudStack Row>
                <MudSwitch T="bool" Label="انتشار" Color="Color.Primary" @bind-Value="_IsPublished" />
                <BaseButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" EndIcon="@Icons.Material.Rounded.Save" OnClick="Submit">ذخیره اطلاعات</BaseButton>
            </MudStack>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Spacing="1">
            <MudItem xs="12" md="4">
                <MudTextField T="string" Label="عنوان" Variant="Variant.Outlined" @bind-Value="_Title" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField T="string" Label="URL" Variant="Variant.Outlined" Class="dnslab-ltr dnslab-nano" @bind-Value="_Url" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="PageType" @bind-Value="_Type" Variant="Variant.Outlined" Label="نوع" Text="@_Type.GetDisplayName()" Disabled="_Id != Guid.Empty">
                    @if (_Types != null)
                    {
                        @foreach (var item in _Types)
                        {
                            <MudSelectItem T="PageType" Value="item">@item.GetDisplayName()</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="توضیحات" Lines="5" Variant="Variant.Outlined" @bind-Value="_Description" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="متن (MD)" Variant="Variant.Outlined" Lines="12" @bind-Value="_Body" />
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>