@using DNSLab.Web.Enums
<MudDialog ContentClass="py-2">
    <DialogContent>
        @if (InvoiceType != InvoiceTypeEnum.Topup)
        {
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText>مبلغ صورتحساب</MudText>
                <MudText>@Amount.Separate3Digits() ریال</MudText>
            </MudStack>

            <MudPaper Outlined Class="my-3 pa-3">
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Row>
                    <MudTextField T="string" Label="کد تخفیف" Margin="Margin.Dense" @bind-Text="_CouponCode" Variant="Variant.Outlined" Class="mt-2 dnslab-ltr dnslab-nano"></MudTextField>
                    <BaseButton Variant="Variant.Filled" Color="Color.Default" OnClick="ProcessCouponCode">اعمال تخفیف</BaseButton>
                </MudStack>
                @if (_CouponDiscountAmount > 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-2" Color="Color.Success">@(_CouponDiscountAmount.Separate3Digits()) ریال تخفیف برای شما اعمال شد</MudText>
                }
            </MudPaper>

            <MudPaper Outlined Class="my-5 pa-5">
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="0">
                    @if (_MyWallet != null)
                    {
                        <MudStack Row Spacing="0" AlignItems="AlignItems.Center">
                            <MudSwitch T="bool" Color="Color.Primary" Label="استفاده از اعتبار حساب" @bind-Value=_UseWallet Disabled="@(_MyWallet.Balance == 0)" />
                            <MudIcon Size="Size.Medium" Color="Color.Primary" class="mr-2" Icon="@DNSLabIcons.Wallet" />
                        </MudStack>
                        <MudText Typo="Typo.caption">
                            اعتبار

                            @((_MyWallet.Balance - (
                                                _UseWallet
                                                ? Math.Min(
                                                Amount - Math.Min(Amount, _CouponDiscountAmount),
                                                _MyWallet.Balance)
                                                : 0
                                                )).Separate3Digits())
                            ریال
                        </MudText>
                    }
                </MudStack>
            </MudPaper>
            <MudDivider Class="mb-5" />

            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h5">قابل پرداخت</MudText>
                <MudText Color="Color.Info" Typo="Typo.h5">
                @(Math.Max(0,
                            Amount
                            - (_UseWallet ? Math.Min(Amount, _MyWallet.Balance) : 0)
                            - Math.Min(
                            Amount - (_UseWallet ? Math.Min(Amount, _MyWallet.Balance) : 0),
                            _CouponDiscountAmount)).Separate3Digits()) ریال
                </MudText>
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <BaseButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Purchass">پرداخت صورتحساب</BaseButton>
    </DialogActions>
</MudDialog>