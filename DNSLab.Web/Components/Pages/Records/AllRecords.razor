@using DNSLab.Web.API.DNS.DTOs.Common
@using DNSLab.Web.API.DNS.DTOs.Common.RecordsData
@using DNSLab.Web.API.DNS.Enums
@using DNSLab.Web.DTOs.Repositories.Record
@attribute [Route(AllRoutes.AllRecords + "/{ZoneId:guid}")]
@attribute [Authorize]
<SeoProvider Title="رکورد های دامنه" />

<MudText Typo="Typo.h1" Align="Align.Center">رکورد‌های دامنه</MudText>
<MudText Class="mt-5 mb-10" Align="Align.Center">این بخش برای افزودن و مدیریت رکورد های دامنه از جمله A , AAAA , TXT و ... میباشد</MudText>

<MudCard Elevation="0">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Spacing="1">
                @if (_ZoneAndRecordsResponse != default)
                {
                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">@_ZoneAndRecordsResponse.Zone.Name</MudText>
                        <BaseIconButton Icon="@Icons.Material.Filled.Sync" Variant="Variant.Filled" DropShadow="false" Size="Size.Small" OnClick="OnInitializedAsync" />
                        <BaseButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Default" DropShadow="false" StartIcon="@Icons.Material.Rounded.ArrowForward" Href="@AllRoutes.AllZones">بازگشت</BaseButton>
                    </MudStack>
                    <MudStack Row Spacing="0">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Label="true" Variant="Variant.Filled">
                            <MudText Typo="Typo.body2">Primary</MudText>
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="@(_ZoneAndRecordsResponse.Zone.Disable ? Color.Warning : Color.Success)" Label="true" Variant="Variant.Filled">
                            <MudText Typo="Typo.body2">@(_ZoneAndRecordsResponse.Zone.Disable ? "غیر فعال" : "فعال")</MudText>
                        </MudChip>
                    </MudStack>
                }
            </MudStack>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" EndIcon="@DNSLabIcons.Add" OnClick="NewRecord">افزودن رکورد</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>

        @if (_RequiredToUpdateNameServers != null && _RequiredToUpdateNameServers.Count() > 0)
        {
            <MudAlert Class="mb-2" Dense Severity="Severity.Warning" Variant="Variant.Outlined" ContentAlignment="HorizontalAlignment.Start">
                <MudText Typo="Typo.body2">برای استفاده از خدمات DNSLab ، باید NS زیر را به جای مقادیر قبلی در تنظیمات دامنه‌ی خود وارد کنید.</MudText>
                <MudText Typo="Typo.body2">
                    توجه داشته باشید که تغییر NS در دامنه ممکن است تا 72 ساعت زمان ببرد.
                </MudText>
                <MudGrid Justify="Justify.SpaceBetween">
                    @if (!_RequiredToUpdateNameServers.All(x => String.IsNullOrEmpty(x)))
                    {
                        <MudItem xs="12" sm="6">
                            <MudAlert Severity="Severity.Error" NoIcon Dense Variant="Variant.Text">
                                @foreach (var item in _RequiredToUpdateNameServers)
                                {
                                    <MudText Class="dnslab-ltr dnslab-nano" Typo="Typo.body2">@item</MudText>
                                }
                            </MudAlert>
                        </MudItem>
                        <MudItem xs="12" sm="1">
                            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                                <MudIcon Icon="@Icons.Material.Filled.ArrowCircleLeft" Color="Color.Primary" Size="Size.Large" />
                            </MudHidden>
                            <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowCircleDown" Color="Color.Primary" Size="Size.Large" />
                            </MudHidden>
                        </MudItem>
                    }
                    <MudItem xs="12" sm="5">
                        <MudAlert Severity="Severity.Success" NoIcon Dense Variant="Variant.Text">
                            <MudText Class="dnslab-ltr dnslab-nano" Typo="Typo.body2">jupiter.ns.dnslab.link</MudText>
                        </MudAlert>
                    </MudItem>
                </MudGrid>

            </MudAlert>
        }

        @if (_ZoneAndRecordsResponse != default)
        {
            <MudDataGrid T="RecordResponse" Items="_ZoneAndRecordsResponse!.Records" ExpandSingleRow Dense Hover Elevation="0" Filterable="false">
                <NoRecordsContent>
                    <NoRecordFound />
                </NoRecordsContent>
                <Columns>
                    <PropertyColumn Property="x => x.Name" Title="نام" />
                    <PropertyColumn Property="x => x.Type" Title="نوع">
                        <CellTemplate>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Label="true">@context.Item.Type</MudChip>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.Ttl" Title="TTL(s)" />
                    <PropertyColumn Property="x => x.Data" Title="مقدار" CellClass="dnslab-ltr dnslab-nano" Sortable="false">
                        <CellTemplate>
                            <MudText Typo="Typo.body2">
                                @switch (context.Item.Type)
                                {
                                    case RecordType.A:
                                        <text>IPv4 : @(((ARecordData)context.Item.Data.Parse(context.Item.Type)).IPv4Address)</text>
                                        break;
                                    case RecordType.AAAA:
                                        <text>IPv6 : @(((AAAARecordData)context.Item.Data.Parse(context.Item.Type)).IPv6Address)</text>
                                        break;
                                    case RecordType.CNAME:
                                        <text>CName : @(((CNAMERecordData)context.Item.Data.Parse(context.Item.Type)).CName)</text>
                                        break;
                                    case RecordType.TXT:
                                        <text>TextData : @(((TXTRecordData)context.Item.Data.Parse(context.Item.Type)).TextData)</text>
                                        break;
                                    case RecordType.MX:
                                        <text>Preference : @(((MXRecordData)context.Item.Data.Parse(context.Item.Type)).Preference)</text>
                                        <text>Exchange : @(((MXRecordData)context.Item.Data.Parse(context.Item.Type)).Exchange)</text>
                                        break;
                                    default:
                                        break;
                                }
                            </MudText>
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.Comment" Title="یادداشت" />
                    <PropertyColumn Property="x => x.Disable" Title="وضعیت">
                        <CellTemplate>
                            @if (context.Item.Disable)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Label="true">غیرفعال</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Label="true">فعال</MudChip>
                            }
                        </CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn StickyLeft>
                        <CellTemplate>
                            <MudStack Row Justify="Justify.FlexEnd" Spacing="1">
                                <BaseIconButton OnClick="() => EditRecord(context.Item)" DropShadow="false" Size="Size.Small" Variant="Variant.Filled" Icon="@DNSLabIcons.Edit" />
                                @* <BaseIconButton OnClick="()=> DisableRecord(context.Item)" DropShadow="false" Size="Size.Small" Variant="Variant.Filled" Icon="@(context.Item.Disable? Icons.Material.Filled.ToggleOn : Icons.Material.Outlined.ToggleOff)" /> *@
                                <BaseIconButton OnClick="() => DeleteRecord(context.Item)" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Icon="@DNSLabIcons.Delete" />
                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="RecordResponse" RowsPerPageString="تعداد ردیف در هر صفحه" InfoFormat="{first_item}-{last_item} از {all_items}" />
                </PagerContent>
            </MudDataGrid>
        }
        
    </MudCardContent>
</MudCard>
