@using DNSLab.Web.API.DNS.DTOs.Common
@using DNSLab.Web.API.DNS.DTOs.Common.RecordsData
@using DNSLab.Web.API.DNS.Enums
@attribute [Route(AllRoutes.TodayChangesDDNS)]
@attribute [Authorize(Roles = AuthorizeRoles.Admin)]
<SeoProvider Title="تغییرات امروز" />

<MudText Typo="Typo.h1" Align="Align.Center">تغییرات DDNS امروز (UTC)</MudText>
<MudText Class="mt-5 mb-10" Align="Align.Center">تمامی تغییرات رکورد هار DDNS از ساعت صفر جهانی در جدول پایین قابل مشاهده میباشد</MudText>

<MudCard>
    <MudCardContent>
        @if (_ZonesAndRecords != null)
        {
            @foreach (var item in _ZonesAndRecords.OrderBy(x => x.Zone.Name))
            {
                <MudCard Class="mb-2" Elevation="0">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5">@item.Zone.Name</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (item.Records.Count() > 0)
                        {
                            <MudDataGrid T="RecordResponse" Items="item.Records.OrderBy(x => x.Name)" Dense Hover Elevation="0">
                                <NoRecordsContent>
                                    <NoRecordFound />
                                </NoRecordsContent>
                                <Columns>
                                    <PropertyColumn Property='x => $"{x.Name}.{item.Zone.Name}"' Title="نام" />
                                    <PropertyColumn Property="x => x.Type" Title="نوع">
                                        <CellTemplate>
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Label="true">@context.Item.Type</MudChip>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn Property="x => x.Ttl" Title="TTL(s)" />
                                    <PropertyColumn Property="x => x.Data" Title="مقدار" CellClass="dnslab-ltr dnslab-nano" Sortable="false">
                                        <CellTemplate>
                                            <MudText Typo="Typo.body2">
                                                @switch (context.Item.Type)
                                                {
                                                    case RecordType.A:
                                                        <text>IPv4 : @(((ARecordData)context.Item.Data.Parse(context.Item.Type)).IPv4Address)</text>
                                                        break;
                                                    case RecordType.AAAA:
                                                        <text>IPv6 : @(((AAAARecordData)context.Item.Data.Parse(context.Item.Type)).IPv6Address)</text>
                                                        break;
                                                    case RecordType.CNAME:
                                                        <text>CName : @(((CNAMERecordData)context.Item.Data.Parse(context.Item.Type)).CName)</text>
                                                        break;
                                                    case RecordType.TXT:
                                                        <text>TextData : @(((TXTRecordData)context.Item.Data.Parse(context.Item.Type)).TextData)</text>
                                                        break;
                                                    case RecordType.MX:
                                                        <text>Preference : @(((MXRecordData)context.Item.Data.Parse(context.Item.Type)).Preference)</text>
                                                        <text>Exchange : @(((MXRecordData)context.Item.Data.Parse(context.Item.Type)).Exchange)</text>
                                                        break;
                                                    default:
                                                        break;
                                                }
                                            </MudText>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn Property="x => x.Comment" Title="یادداشت" />
                   
                                </Columns>
                                <PagerContent>
                                    <MudDataGridPager T="RecordResponse" RowsPerPageString="تعداد ردیف در هر صفحه" InfoFormat="{first_item}-{last_item} از {all_items}" />
                                </PagerContent>
                            </MudDataGrid>
                        }
                    </MudCardContent>
                </MudCard>
            }
        }
    </MudCardContent>
</MudCard>
                            
