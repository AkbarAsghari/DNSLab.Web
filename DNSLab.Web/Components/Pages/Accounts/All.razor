@attribute [Route(AllRoutes.AllAcounts)]
@attribute [Authorize(Roles = AuthorizeRoles.Admin)]

<SeoProvider Title="لیست تمام کاربران" />
<MudText Typo="Typo.h3" Class="mb-3">لیست تمام کاربران</MudText>


@if (Profiles != null)
{
    <MudDataGrid Items="@Profiles">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="Id" />
            <PropertyColumn Property="x => x.FirstName" />
            <PropertyColumn Property="x => x.LastName" />
            <PropertyColumn Property="x => x.Username" />
            <PropertyColumn Property="x => x.Email" />
            <PropertyColumn Property="x => x.Mobile" />
            <PropertyColumn Property="x => x.Role" />
        </Columns>
    </MudDataGrid>
}