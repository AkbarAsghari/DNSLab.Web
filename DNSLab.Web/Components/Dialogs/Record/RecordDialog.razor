@using DNSLab.Web.API.DNS.Enums
@using DNSLab.Web.Enums
<MudDialog ContentClass="py-2">
    <DialogContent>
        <MudStack>
            <MudStack Row AlignItems="AlignItems.Center" Spacing="0">
                <MudTextField T="string" Class="dnslab-ltr dnslab-nano" Variant="Variant.Outlined" ReadOnly Label="دامنه" Text="@($".{Zone.Name}")" />
                <MudTextField T="string" @bind-Value="_Name" Variant="Variant.Outlined" Placeholder="@("@")" Class="dnslab-ltr dnslab-nano" FullWidth Label="نام" />
            </MudStack>
            <MudSelect T="RecordType" @bind-Value="_Type" Variant="Variant.Outlined" Label="نوع" Disabled="Record != default">
                @foreach (RecordType item in (IsDDNS ? DNSSettings.SupportedRecordForDDNS : DNSSettings.SupportedRecordForDomain))
                {
                    <MudSelectItem T="RecordType" Value="item">@item</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="@(_IsAbleToChangeTTL ? String.Empty : "اشتراک فعلی شما قابلیت ویرایش TTL را پوشش نمیدهد لطفا اشتراک تهیه فرمایید")">
                <MudNumericField T="int" @bind-Value="_Ttl" Disabled="!_IsAbleToChangeTTL" Variant="Variant.Outlined" Min="0" Max="int.MaxValue" Placeholder="60" Label="TTL(s)" />
            </MudTooltip>
            @switch (_Type)
            {
                case RecordType.A:
                    <MudTextField T="string" @bind-Value="_IPv4Address" Variant="Variant.Outlined" Placeholder="@_HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress!.ToString()" Class="dnslab-ltr dnslab-nano" Label="IPv4" />
                    break;
                case RecordType.AAAA:
                    <MudTextField T="string" @bind-Value="_IPv6Address" Variant="Variant.Outlined" Placeholder="2001:0000:130F:0000:0000:09C0:876A:130B" Class="dnslab-ltr dnslab-nano" Label="IPv6" />
                    break;
                case RecordType.TXT:
                    <MudTextField T="string" @bind-Value="_TextData" Variant="Variant.Outlined" Lines="3" MaxLines="5" Placeholder="Text Data ..." Class="dnslab-ltr dnslab-nano" Label="Text Data" />
                    break;
                case RecordType.CNAME:
                    <MudTextField T="string" @bind-Value="_CName" Variant="Variant.Outlined" Placeholder="api.dnslab.link" Class="dnslab-ltr dnslab-nano" Label="CName" />
                    break;
                case RecordType.MX:
                    <MudTextField T="string" @bind-Value="_Exchange" Variant="Variant.Outlined" Placeholder="api.dnslab.link" Class="dnslab-ltr dnslab-nano" Label="Exchange" />
                    <MudNumericField T="UInt16" @bind-Value="_Preference" Variant="Variant.Outlined" Min="UInt16.MinValue" Max="UInt16.MaxValue" Placeholder="1" Label="Preference" />
                    break;
            }
            <MudTextField T="string" @bind-Value="_Comment" Variant="Variant.Outlined" Lines="3" MaxLines="5" Label="یادداشت" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <BaseButton OnClick="Cancel">انصراف</BaseButton>
        <BaseButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@(Record == default ? "ایجاد رکورد" : "ویرایش")</BaseButton>
    </DialogActions>
</MudDialog>