@using ApexCharts
@using DNSLab.Web.API.Wallet.DTOs
@using DNSLab.Web.API.Wallet.Enums
@attribute [Route(AllRoutes.MyWallet)]
@attribute [Authorize]

<SeoProvider Title="کیف پول" />

<MudText Typo="Typo.h1" Align="MudBlazor.Align.Center">کیف پول</MudText>
<MudText Class="mt-5 mb-10" Align="MudBlazor.Align.Center">در صورت نیاز به افزایش موجودی کیف پول از دکمه افزایش موجودی استفاده نمایید</MudText>

<MudCard Elevation="0">
    <MudCardHeader>
        <CardHeaderContent />
        <CardHeaderActions>
            <MudButton EndIcon="@DNSLabIcons.Add" Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" OnClick="IncreaseBalance">افزایش موجودی</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                @if (_Wallet is not null)
                {
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h3">@_Wallet.Balance.Separate3Digits()</MudText>
                        <MudText Typo="Typo.body2">ریال</MudText>
                    </MudStack>
                }
            </MudItem>
            <MudFlexBreak />
            <MudItem xs="12" md="5">
                @if (_Last30DaysTransactionsChartDataChartData is { Count: > 0 })
                {
                    <ApexChart TItem="WalletTransactionChartPoint" Options="_last30DaysTransactionsChartOptions">
                        <ApexPointSeries TItem="WalletTransactionChartPoint"
                                         Items="_Last30DaysTransactionsChartDataChartData"
                                         SeriesType="SeriesType.Area"
                                         Name="مقدار"
                                         XValue="e => e.Date.ToPersianDate()"
                                         YValue="e => e.Amount"
                                         OrderBy="e => e.X" />
                    </ApexChart>
                }
            </MudItem>
            <MudItem xs="12" md="7">
                @if (_WalletTransactions is not null)
                {
                    <MudDataGrid T="WalletTransactionResponse" Items="_WalletTransactions.Items" Dense Hover Elevation="0">
                        <NoRecordsContent>
                            <NoRecordFound />
                        </NoRecordsContent>
                        <Columns>
                            <PropertyColumn Property="x => x.TransactionType.GetDisplayName()" Title="نوع" />
                            <TemplateColumn Title="مبلغ (ریال)">
                                <CellTemplate>
                                    <MudAlert Severity="@(context.Item.TransactionType == WalletTransactionType.Withdrawal ? Severity.Success : Severity.Error)" NoIcon Dense ContentAlignment="HorizontalAlignment.Center">
                                        <MudText>@context.Item.Amount.Separate3Digits()</MudText>
                                    </MudAlert>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                }
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>